<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Shown while browsing -->
    <group android:id="@+id/group_browse">
        <item
            android:id="@+id/action_search"
            android:icon="@drawable/ic_search"
            android:title="@string/search"
            app:actionViewClass="androidx.appcompat.widget.SearchView"
            app:showAsAction="ifRoom|collapseActionView" />
        <item
            android:id="@+id/action_sort"
            android:title="@string/sort"
            app:showAsAction="never" />
        <item
            android:id="@+id/action_hidden"
            android:checkable="true"
            android:title="@string/show_hidden"
            app:showAsAction="never" />
        <item
            android:id="@+id/action_home"
            android:title="@string/go_to_root"
            app:showAsAction="never" />
    </group>

    <!-- Shown while files are selected -->
    <group
        android:id="@+id/group_select"
        android:visible="false">
        <item
            android:id="@+id/action_copy"
            android:icon="@drawable/ic_copy"
            android:title="@string/copy"
            app:showAsAction="ifRoom" />
        <item
            android:id="@+id/action_delete"
            android:icon="@drawable/ic_delete"
            android:title="@string/delete"
            app:showAsAction="ifRoom" />
        <item
            android:id="@+id/action_cut"
            android:title="@string/cut"
            app:showAsAction="never" />
        <item
            android:id="@+id/action_share"
            android:title="@string/share"
            app:showAsAction="never" />
        <item
            android:id="@+id/action_rename"
            android:title="@string/rename"
            app:showAsAction="never" />
        <item
            android:id="@+id/action_select_all"
            android:title="@string/select_all"
            app:showAsAction="never" />
        <item
            android:id="@+id/action_details"
            android:title="@string/details"
            app:showAsAction="never" />
    </group>
</menu>
